@model IEnumerable<E_Learning_Platform.Models.ViewModel.StudentListDto>

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Manage Students</h3>

        @Ajax.ActionLink(
            "Add Student",
            "AddStudentModal",
            "Admin",
            new AjaxOptions
            {
                HttpMethod = "GET",
                InsertionMode = InsertionMode.Replace,
                UpdateTargetId = "newstudent",
                OnSuccess = "$('#addStudentModal').modal('show');"
            },
            new { @class = "btn btn-primary px-4" }
        )
    </div>

    <!-- Filters Section -->
    @using (Ajax.BeginForm("FilterStudent", "Admin", new AjaxOptions
    {
        HttpMethod = "GET",
        InsertionMode = InsertionMode.Replace,
        UpdateTargetId = "stdtable",
    }))
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-5">
                        <input type="text" class="form-control" placeholder="Search by name or email" name="search">
                    </div>

                    <div class="col-md-3">
                        @Html.DropDownList("CourseName", ViewBag.CoursesFilter as SelectList, "Filter By Course", new { @class = "form-select" })
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" name="Status">
                            <option selected>Status</option>
                            <option value="11">Active</option>
                            <option value="22">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-primary">Filter</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Student Table -->
    <div id="stdtable">
        <div class="card shadow-sm border-0">
            <div class="card-body table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Profile</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Course</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Count() > 0)
                        {
                            foreach (var std in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="~/photo/profile.jpeg" alt="profile" class="rounded-circle" width="40">
                                    </td>
                                    <td class="text-truncate mx-width-12" title="@std.Name">@std.Name</td>
                                    <td class="text-truncate mx-width-14" title="@std.Gmail">@std.Gmail</td>
                                    <td title="@std.Phone">@std.Phone</td>
                                    <td title="@std.CourseTitle" class="text-truncate mx-width-2">@std.CourseTitle</td>
                                    <td title="@std.Duration">@std.Duration</td>
                                    <td><span class="badge bg-success">@std.Status</span></td>
                                    <td class="text-end">
                                        <a href="@Url.Action("StudentDetails", "Admin",new { id = std.SId })"
                                           class="btn btn-sm btn-outline-primary"
                                           title="View Details"
                                           data-ajax="true"
                                           data-ajax-method="GET"
                                           data-ajax-mode="replace"
                                           data-ajax-update="#target">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @Ajax.ActionLink(
                                            " ",
                                            "EditDetails",
                                            "Admin",
                                            new { id = std.SId },
                                            new AjaxOptions
                                            {
                                                HttpMethod = "GET",
                                                InsertionMode = InsertionMode.Replace,
                                                UpdateTargetId = "newstudent",
                                                OnSuccess = "$('#addStudentModal').modal('show');"
                                            },
                                            new { @class = "btn btn-sm btn-outline-warning bi bi-pencil", title = "Edit Details" }
                                        )
                                        <a href="@Url.Action("DeleteStudent", "Admin",new { id = std.SId })"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete"
                                           data-ajax="true"
                                           data-ajax-method="GET"
                                           data-ajax-mode="replace"
                                           data-ajax-update="#stdtable">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td class="text-info text-center" colspan="8">No Student Record Found...</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<!-- Add Student Modal -->
<div id="newstudent">

</div>
