@model E_Learning_Platform.Models.ViewModel.StudentListDto
<div class="modal fade" id="addStudentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">

            @using (Ajax.BeginForm((Model.SId == 0 ? "NewStudent" : "UpdateStudent"), "Admin", new AjaxOptions
            {
                HttpMethod = "POST",
                OnSuccess = "onStudentSaveSuccess",
                OnFailure = "onStudentSaveFailure",
                LoadingElementId = "saveSpinner"
            }, new { id = "newStudentForm" }))
            {
                @Html.HiddenFor(s => s.SId)
                @Html.HiddenFor(s => s.UId)
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(Model.SId==0?"Add New Student":"Update Student Details")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            @Html.TextBoxFor(s => s.Name, new { placeholder = "Enter Full Name", @class = "form-control", required = "required" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            @Html.TextBoxFor(s => s.Gmail, new { placeholder = "Enter email", @class = "form-control", required = "required" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Father Name</label>
                            @Html.TextBoxFor(s => s.FatherName, new { placeholder = "Enter father name", @class = "form-control", required = "required" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mother</label>
                            @Html.TextBoxFor(s => s.MotherName, new { placeholder = "Enter Mother Name", @class = "form-control", required = "required" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Gender</label>

                            @Html.DropDownListFor(s=>s.Gender,new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Male", Value = "Male" },
                                    new SelectListItem { Text = "Female", Value = "Female" },
                                    new SelectListItem { Text = "Other", Value = "Other" }
                                },
                                "Select Gender",
                                new { @class = "form-select" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            @Html.TextBoxFor(s => s.Phone, new { placeholder = "Enter phone number", @class = "form-control", required = "required" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Course</label>
                            @Html.DropDownListFor(s=>s.CourseId, ViewBag.Courses as SelectList, "--Select Course--", new { @class = "form-select", required = "required" })
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Address</label>
                            @Html.TextAreaFor(s => s.Address, new { placeholder = "Enter full address", @class = "form-control", required = "required" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <!-- Optional loading spinner -->
                    <div id="saveSpinner" class="spinner-border text-primary spinner-border-sm me-2" role="status" style="display:none;">
                        <span class="visually-hidden">Loading...</span>
                    </div>

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">@(Model.SId==0?"Add Student":"Update")</button>
                </div>
            }

        </div>
    </div>
</div>
<script>
    function onStudentSaveSuccess(response) {
        if (response.success) {
            $('#addStudentModal').modal('hide');

            $('#newStudentForm')[0].reset();

            $.get('@Url.Action("ManageStudent", "Admin")', function (htmlData) {
            $('#target').html(htmlData);
        });
        } else {
            alert('Validation Error: ' + response.message);
        }
    }

    function onStudentSaveFailure(xhr) {
        alert('An unexpected error occurred while saving.');
    }
    function onFiltered(response) {

    }
</script>